generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum LocationType {
  CAMPUS
  BUILDING
  FLOOR
  AREA
}

enum ComplaintType {
  CLEANING
  PLUMBING
  ELECTRICAL
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ComplaintStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  submittedComplaints Complaint[] @relation("SubmittedBy")
  assignedComplaints  Complaint[] @relation("AssignedTo")
}

model Location {
  id          String   @id @default(cuid())
  name        String
  type        LocationType
  parentId    String?
  parent      Location? @relation("Hierarchy", fields: [parentId], references: [id])
  children    Location[] @relation("Hierarchy")
  qrCodeUrl   String   @unique
  complaints  Complaint[]
}

model Complaint {
  id           String   @id @default(cuid())
  type         ComplaintType
  description  String
  imageUrl     String?
  priority     Priority @default(MEDIUM)
  status       ComplaintStatus @default(PENDING)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  locationId   String
  location     Location @relation(fields: [locationId], references: [id])
  reporterId   String?
  reporter     User? @relation("SubmittedBy", fields: [reporterId], references: [id])
  reporterName String?
  reporterEmail String?
  assigneeId   String?
  assignee     User? @relation("AssignedTo", fields: [assigneeId], references: [id])
}
